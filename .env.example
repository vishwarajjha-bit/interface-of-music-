# GEMINI_API_KEY: Optional Gemini API key (configured via AI Studio Secrets if used).
GEMINI_API_KEY=

# APP_URL: Public URL where this Ondine Mini App & Express backend is hosted.
APP_URL=

# MUSIC_API_KEY: API key for riteshyt.in music scraping & download mirrors.
MUSIC_API_KEY=

# MUSIC_API_URLS: Optional comma-separated download/search mirrors (defaults to the 4 riteshyt.in endpoints).
MUSIC_API_URLS=https://www.riteshyt.in,https://api.riteshyt.in,https://web.riteshyt.in,https://yt.riteshyt.in

# BOT_TOKEN: Telegram Bot token from @BotFather (required for cryptographic initData & group admin verification).
BOT_TOKEN=

# BOT_BRIDGE_SECRET: Shared secret between the Python AloneMusic bot (AWS) and this Mini App server.
BOT_BRIDGE_SECRET=

# BOT_USERNAME: Optional Telegram bot username without @ for deep links.
BOT_USERNAME=
